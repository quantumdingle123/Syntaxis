-- [ SYNTAX HUB - STEAL AN EGG ]
-- Modular Entrypoint & Remote Loader
-- Repository: https://github.com/quantumdingle123/Syntaxis
-- Modules: Core, Safety, Bloom, UFO, Scheduler, StealMovement, Workers, UI
-- ==============================================================================

local Syntaxis = {
    Version = "2.3.0",
    RepoBaseUrl = "https://raw.githubusercontent.com/quantumdingle123/Syntaxis/main/src/",
    Shared = {}
}

local function fetchRemoteSource(url)
    local lastErr
    for attempt = 1, 2 do
        local ok, res = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and type(res) == "string" and #res > 0 then
            return res
        end
        lastErr = res
        if attempt < 2 then
            task.wait(0.15)
        end
    end
    error("[Syntaxis] Failed to download module (" .. tostring(url) .. "): " .. tostring(lastErr))
end

local function loadModule(name)
    if Syntaxis._Preloaded and Syntaxis._Preloaded[name] then
        return Syntaxis._Preloaded[name](Syntaxis.Shared)
    end
    local url = Syntaxis.RepoBaseUrl .. name .. ".lua"
    local src = fetchRemoteSource(url)
    local fn, err = loadstring(src, "Syntaxis." .. name)
    if not fn then
        error("[Syntaxis] Failed to compile module " .. tostring(name) .. ": " .. tostring(err))
    end
    local init = fn()
    if type(init) == "function" then
        return init(Syntaxis.Shared)
    end
    return init
end

local MODULE_ORDER = {
    "Core",
    "Safety",
    "Bloom",
    "UFO",
    "Scheduler",
    "StealMovement",
    "Workers",
    "UI"
}

for _, modName in ipairs(MODULE_ORDER) do
    loadModule(modName)
end

return Syntaxis
